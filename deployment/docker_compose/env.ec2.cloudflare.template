# ============================================
# Onyx EC2 configuration for a Cloudflare
# Access + Tunnel deployment.
# Non-secret values only.
# ============================================

# -- App --
IMAGE_TAG=latest
WEB_DOMAIN=https://onyx.company.com

# Optional: override the default image references with full image names
# including tags. Leave these commented out to keep using upstream
# onyxdotapp images controlled by IMAGE_TAG.
# ONYX_BACKEND_IMAGE=ghcr.io/mattb543/onyx-backend:latest
# ONYX_WEB_SERVER_IMAGE=ghcr.io/mattb543/onyx-web-server:latest
# ONYX_MODEL_SERVER_IMAGE=ghcr.io/mattb543/onyx-model-server:latest

# Cloudflare Access sits in front of the network path, but Onyx still
# keeps its own application login/session layer.
AUTH_TYPE=basic
VALID_EMAIL_DOMAINS=company.com
SESSION_EXPIRE_TIME_SECONDS=604800
LICENSE_ENFORCEMENT_ENABLED=false

# -- Database --
POSTGRES_USER=postgres
DB_READONLY_USER=db_readonly_user

# -- File Storage (MinIO / S3-compatible) --
FILE_STORE_BACKEND=s3
S3_ENDPOINT_URL=http://minio:9000
S3_FILE_STORE_BUCKET_NAME=onyx-file-store-bucket
S3_AWS_ACCESS_KEY_ID=minioadmin
MINIO_ROOT_USER=minioadmin

# -- AWS Secret Bootstrap --
AWS_REGION_NAME=us-east-2
AWS_SSM_SECRETS_PREFIX=/onyx/prod/secrets

# -- KMS Envelope Encryption --
SECRET_ENCRYPTION_MODE=aws_kms_envelope
SECRET_ENCRYPTION_REQUIRED=true
AWS_KMS_KEY_ID=<your-kms-key-id>
AWS_ENCRYPTED_DEK_PARAM=/onyx/prod/encrypted_dek/v{version}
SECRET_KEY_VERSION=1
SECRET_OLD_KEY_VERSIONS=
# Only needed when migrating old AES-CBC encrypted secrets.
# ENCRYPTION_KEY_SECRET=<legacy-encryption-key>

# -- Logging --
LOG_LEVEL=info
SHOW_EXTRA_CONNECTORS=false

# -- Cloudflare Tunnel Origin --
TUNNEL_ORIGIN_PORT=8080
